# syntax=docker/dockerfile:1
# The official upstream Dockerfile uses Temurin 17 on Ubuntu Jammy.
FROM eclipse-temurin@sha256:73ed442231ec66cfe48cae0b263ce619a75ab96d162ab325f38fc0a269ee3aab AS base
RUN --mount=type=secret,id=proxy_ca \
    bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -f /run/secrets/proxy_ca ]; then bundle=/run/secrets/proxy_ca; fi; \
    apt-get -o Acquire::https::CaInfo="$bundle" update && \
    apt-get -o Acquire::https::CaInfo="$bundle" install -y \
      --no-install-recommends python3 ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/*

FROM base AS build
RUN --mount=type=secret,id=proxy_ca \
    bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -f /run/secrets/proxy_ca ]; then bundle=/run/secrets/proxy_ca; fi; \
    apt-get -o Acquire::https::CaInfo="$bundle" update && \
    apt-get -o Acquire::https::CaInfo="$bundle" install -y \
      --no-install-recommends git curl unzip patch && \
    rm -rf /var/lib/apt/lists/*
COPY source_build.py /build-tools/source_build.py
RUN --mount=type=secret,id=proxy_ca \
    python3 /build-tools/source_build.py /build /out

FROM base AS runtime
LABEL org.opencontainers.image.source="https://github.com/TAK-Product-Center/Server" \
      org.opencontainers.image.revision="5187abd46d827d37cfc5708805eced197a837e49" \
      org.opencontainers.image.version="5.7-RELEASE-14"
COPY --from=build /out/tak /opt/tak
COPY --from=build /out/provenance.json /opt/tak/fixture-provenance.json
COPY fixture-entrypoint.sh /opt/tak/fixture-entrypoint.sh
COPY configure.py /opt/tak/fixture-configure.py
ENTRYPOINT ["/bin/bash", "/opt/tak/fixture-entrypoint.sh"]
